{
  "name": "@flagr/flagr-openfeature-provider-js",
  "version": "0.0.1",
  "description": "Flagr OpenFeature provider",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run src/__tests__/unit/",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.20.0"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@openfeature/server-sdk": "^1.20.1",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.12.7",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "openfeature",
    "feature-flags",
    "flagr",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openflagr/flagr-openfeature-provider-js"
  },
  "license": "Apache-2.0"
}
